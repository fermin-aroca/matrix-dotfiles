[init]
    defaultBranch = main
[core]
    editor = vim
    autocrlf = input
[pull]
    ff = only
[push]
    default = simple
    autoSetupRemote = true
[fetch]
    prune = true
[diff]
    algorithm = histogram
[merge]
    conflictStyle = zdiff3
[color]
    ui = auto
[alias]
    st = status --short --branch
    lg = log --graph --decorate --oneline --all
[include]
    path = ~/.gitconfig.local
